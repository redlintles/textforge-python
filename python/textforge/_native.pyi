from typing import TypeAlias

__version__: str

class TextForgeError(Exception):
    stage: str
    code: int
    message: str
    instruction: str
    input: str

class Variable:
    def __init__(self, name: str) -> None: ...
    @property
    def name(self) -> str: ...

Argument: TypeAlias = "str | int | Variable | Instruction"

class Instruction:
    def __init__(self, name: str, *arguments: Argument) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def arguments(self) -> tuple[Argument, ...]: ...

class CompiledPipeline:
    def process(self, input: str) -> str: ...
    def __call__(self, input: str) -> str: ...

class Plan:
    def __init__(self) -> None: ...
    def add(self, instruction: Instruction) -> None: ...
    def block(self, name: str, body: Plan) -> None: ...
    def contains_each(self, pattern: str, body: Plan) -> None: ...
    def compile(self) -> CompiledPipeline: ...

class Processor:
    def __init__(self) -> None: ...
    def register(self, plan: Plan) -> str: ...
    def remove_transform(self, id: str) -> None: ...
    def transform_exists(self, id: str) -> bool: ...
    def list_transforms(self) -> list[str]: ...
    def clone_pipeline(self, id: str) -> str: ...
    def get_transform_vec(self, id: str) -> list[Instruction]: ...
    def process_batch(
        self, tasks: list[tuple[str, str, str]], threads: int = 0
    ) -> list[TextForgeError | None]: ...
    def get_text_transform_vec(self, id: str) -> list[str]: ...
    def process_all(self, id: str, input: str) -> str: ...
    def run_transform(self, id: str, input: str) -> str: ...
    def process_single(self, instruction: Instruction, input: str) -> str: ...
    def process_all_with_debug(self, id: str, input: str) -> str: ...
    def process_single_with_debug(self, instruction: Instruction, input: str) -> str: ...
    def get_pipeline_from_file(self, path: str) -> str: ...
    def write_pipeline_to_file(self, id: str, path: str) -> None: ...
    def read_from_bytecode_file(self, path: str) -> str: ...
    def write_to_bytecode_file(self, id: str, path: str) -> None: ...
    def process_file(self, id: str, input: str, output: str) -> None: ...
