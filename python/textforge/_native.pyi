from collections.abc import Callable
from typing import TypeAlias

from ._buffers import StreamReader, StreamWriter

__version__: str

class TextForgeError(Exception):
    stage: str
    code: int
    message: str
    instruction: str
    input: str

class Variable:
    def __init__(self, name: str) -> None: ...
    @property
    def name(self) -> str: ...

Argument: TypeAlias = "str | int | Variable | Instruction"

class Instruction:
    def __init__(self, name: str, *arguments: Argument) -> None: ...
    @property
    def name(self) -> str: ...
    @property
    def arguments(self) -> tuple[Argument, ...]: ...

class CompiledPipeline:
    def process(self, input: str) -> str: ...
    def __call__(self, input: str) -> str: ...

class Plan:
    def __init__(self) -> None: ...
    def add(self, instruction: Instruction) -> None: ...
    def block(self, name: str, body: Plan) -> None: ...
    def contains_each(self, pattern: str, body: Plan) -> None: ...
    def compile(self) -> CompiledPipeline: ...

class Processor:
    def __init__(self) -> None: ...
    def register(self, plan: Plan) -> str: ...
    def remove_transform(self, id: str) -> None: ...
    def transform_exists(self, id: str) -> bool: ...
    def list_transforms(self) -> list[str]: ...
    def clone_pipeline(self, id: str) -> str: ...
    def get_transform_vec(self, id: str) -> list[Instruction]: ...
    def process_batch(
        self, tasks: list[tuple[FilePath, str, FilePath]], threads: int = 0
    ) -> list[TextForgeError | None]: ...
    def get_text_transform_vec(self, id: str) -> list[str]: ...
    def process_all(self, id: str, input: str) -> str: ...
    def run_transform(self, id: str, input: str) -> str: ...
    def process_single(self, instruction: Instruction, input: str) -> str: ...
    def process_all_with_debug(self, id: str, input: str) -> str: ...
    def process_single_with_debug(self, instruction: Instruction, input: str) -> str: ...
    def get_pipeline_from_file(self, path: FilePath) -> str: ...
    def write_pipeline_to_file(self, id: str, path: FilePath) -> None: ...
    def read_from_bytecode_file(self, path: FilePath) -> str: ...
    def write_to_bytecode_file(self, id: str, path: FilePath) -> None: ...
    def process_file(self, id: str, input: FilePath, output: FilePath) -> None: ...
    def add_transform(self, instructions: list[Instruction]) -> str: ...
    def show_transforms(self) -> None: ...
    def process_batch_in_pool(
        self, pool: BatchPool, tasks: list[tuple[FilePath, str, FilePath]]
    ) -> list[TextForgeError | None]: ...
    def process_all_with_watchers(
        self, id: str, input: str, observers: Observers, report: FilePath
    ) -> str: ...
    def process_all_buffered(self, id: str, input: PortableBuffer) -> PortableBuffer: ...
    def process_single_buffered(
        self, instruction: str, input: PortableBuffer
    ) -> PortableBuffer: ...
    def process_file_buffered(
        self, id: str, input: FilePath, options: BufferOptions
    ) -> PortableBuffer: ...
    def process_batch_buffered(
        self, tasks: list[tuple[str, FilePath]], options: BufferOptions
    ) -> list[PortableBuffer | TextForgeError]: ...

class FilePath:
    @staticmethod
    def from_text(path: str) -> FilePath: ...
    @staticmethod
    def from_native_bytes(bytes: bytes) -> FilePath: ...
    @staticmethod
    def from_windows_wide(wide: list[int]) -> FilePath: ...
    def to_text(self) -> str | None: ...
    def to_native_bytes(self) -> bytes: ...
    def to_windows_wide(self) -> list[int]: ...

class Features:
    @property
    def bytecode(self) -> bool: ...
    @property
    def watchers(self) -> bool: ...
    @property
    def buffered(self) -> bool: ...

def features() -> Features: ...

class BatchPool:
    def __init__(self, threads: int = 0) -> None: ...
    def close(self) -> None: ...
    @property
    def closed(self) -> bool: ...

class BufferOptions:
    def __init__(self, memory_threshold: int, spill_directory: FilePath) -> None: ...

class PortableBuffer:
    @staticmethod
    def from_text(text: str, options: BufferOptions) -> PortableBuffer: ...
    @staticmethod
    def from_file(path: FilePath, options: BufferOptions) -> PortableBuffer: ...
    @staticmethod
    def from_reader(reader: StreamReader, options: BufferOptions) -> PortableBuffer: ...
    def len_bytes(self) -> int: ...
    def is_empty(self) -> bool: ...
    def is_spilled(self) -> bool: ...
    def spill(self) -> None: ...
    def read_at(self, offset: int, maximum: int) -> bytes: ...
    def copy_to(self, writer: StreamWriter) -> int: ...
    def write_to_file(self, path: FilePath) -> int: ...
    def into_string(self) -> str: ...
    def close(self) -> None: ...
    @property
    def closed(self) -> bool: ...

class Observation:
    def __init__(self, current: str, before: str, after: str | None, instruction: str) -> None: ...
    @property
    def current(self) -> str: ...
    @property
    def before(self) -> str: ...
    @property
    def after(self) -> str | None: ...
    @property
    def instruction(self) -> str: ...

class Observers:
    def __init__(self) -> None: ...
    def set(self, name: str, callback: Callable[[Observation], str]) -> None: ...
    def set_builtin(self, name: str, metric: str) -> None: ...
    @staticmethod
    def builtin_names() -> list[str]: ...
    def schedule_all(self, name: str) -> None: ...
    def reset(self) -> None: ...
    def run(self, observation: Observation) -> None: ...
    def write_report(self, path: FilePath) -> None: ...
    def clear(self) -> None: ...
